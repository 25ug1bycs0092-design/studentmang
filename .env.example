FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///campusly.sqlite
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
JWT_ACCESS_TOKEN_MINUTES=60

# Set only when running `flask seed-demo`; all seeded demo accounts use this
# password. Do not set or use demo seed credentials in production.
SEED_PASSWORD=
